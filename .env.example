LUMINA_WEARABLE_MODE=true
LUMINA_SCHOOL_MODE=true

LUMINA_CAMERA_WIDTH=1920
LUMINA_CAMERA_HEIGHT=1080
LUMINA_CAMERA_HFLIP=false
LUMINA_CAMERA_VFLIP=false
LUMINA_CAMERA_AF_MODE=continuous
LUMINA_CAMERA_AF_RANGE=full
LUMINA_CAMERA_AF_SPEED=fast
LUMINA_CAMERA_COLOR_MODE=rgb_to_bgr
LUMINA_CAMERA_REFOCUS_BEFORE_OCR=true
LUMINA_CAMERA_REFOCUS_INTERVAL_SECONDS=3.0
LUMINA_CAMERA_FOCUS_SETTLE_SECONDS=0.7
LUMINA_CAMERA_FRAMERATE=8
LUMINA_PREVIEW_MAX_WIDTH=960

LUMINA_ENABLE_OBJECT_DETECTION=true
LUMINA_ENABLE_OCR=true
LUMINA_ENABLE_TTS=true
LUMINA_SHOW_PREVIEW=false
LUMINA_SAVE_DEBUG_FRAMES=false

LUMINA_DETECTION_MODEL_PATH=models/efficientdet_lite0.tflite
LUMINA_LABELS_PATH=models/coco_labels.txt
LUMINA_DETECTION_SCORE_THRESHOLD=0.55
LUMINA_DETECTION_MAX_RESULTS=5
LUMINA_DETECTION_RUN_EVERY_N_FRAMES=2

LUMINA_OCR_LANGUAGE=spa+eng
LUMINA_OCR_AUTO_READ=true
LUMINA_OCR_RUN_INTERVAL_SECONDS=1.6
LUMINA_OCR_MIN_TEXT_LENGTH=4
LUMINA_OCR_MAX_WIDTH=1600
LUMINA_OCR_MIN_SHARPNESS=20.0
LUMINA_OCR_STABLE_READS=1
LUMINA_OCR_PREFER_CENTER_CROP=true
LUMINA_OCR_SUPPRESS_OBJECTS_SECONDS=4.0

LUMINA_TTS_ENGINE=auto
LUMINA_TTS_OUTPUT=direct
LUMINA_TTS_STARTUP_TEST=false
LUMINA_PIPER_MODEL_PATH=models/tts/es_MX-ald-medium.onnx
LUMINA_PIPER_OUTPUT_FILE=/tmp/lumina_voice.wav
LUMINA_PIPER_CACHE_DIR=/tmp/lumina_piper_cache
LUMINA_SPEECH_RATE=170
LUMINA_SPEECH_VOLUME=1.0
LUMINA_SPEECH_COOLDOWN_SECONDS=4.0
LUMINA_SPEECH_OBJECT_COOLDOWN_SECONDS=2.5
LUMINA_SPEECH_OCR_COOLDOWN_SECONDS=1.5
LUMINA_SPEECH_REPEAT_SAME_OBJECT_SECONDS=20.0
LUMINA_SPEECH_MAX_QUEUE_SIZE=1
LUMINA_SPEECH_ENABLE_OBJECTS=true
LUMINA_SPEECH_ENABLE_OCR=true

LUMINA_LOG_LEVEL=INFO
